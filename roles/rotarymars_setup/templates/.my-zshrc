ulimit -n 8192

# Keep PATH/fpath entries unique. Without this every nested or re-sourced
# shell re-appends the blocks below, so PATH grows without bound.
typeset -U path PATH fpath
export PATH="$PATH:/opt/nvim-linux64/bin"
alias pbcopy='wl-copy'
alias g='git'
alias ls='eza --icons -g --git'
alias l='ls'
export PATH="$PATH:/home/rotarymars/.local/bin:/home/rotarymars/.cargo/bin"
export PATH="$PATH:/home/rotarymars/.platformio/penv/bin"
alias compile='clang++ -g -std=c++2b'
alias accnew='npx acc new --template kyopuro'
alias accadd='npx acc add --template kyopuro'
alias allissues='gh search issues --assignee @me --state open'
alias allprs='gh search prs --assignee @me --state open'
alias nvim='/opt/nvim/AppRun'
alias clion='/opt/clion/bin/clion'
alias datagrip='/opt/DataGrip/bin/datagrip'
alias dataspell='/opt/dataspell/bin/dataspell'
alias pycharm='/opt/pycharm/bin/pycharm'
alias webstorm='/opt/webstorm/bin/webstorm'
alias idea='/opt/idea/bin/idea'
# fortune
# fastfetch
. "$HOME/.asdf/asdf.sh"

# Completion scripts that would otherwise be generated by a subprocess on
# every shell start. Cache each to a file and refresh only when the tool's
# binary is newer than the cached copy.
ZSH_COMPLETION_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
[[ -d $ZSH_COMPLETION_CACHE ]] || mkdir -p "$ZSH_COMPLETION_CACHE"

_completion_cache_changed=0

_cache_completion() {
  # usage: _cache_completion <tool> <command that prints the completion script>
  local tool=$1; shift
  local out="$ZSH_COMPLETION_CACHE/_$tool"
  (( $+commands[$tool] )) || return 0
  [[ -s $out && $out -nt $commands[$tool] ]] && return 0
  if "$@" >| "$out" 2>/dev/null && [[ -s $out ]]; then
    _completion_cache_changed=1
  else
    # generation failed (tool too old, broken, etc.) - do not leave a stub
    # behind, and leave the flag alone so we retry on the next shell.
    rm -f "$out"
  fi
}

_cache_completion gh gh completion -s zsh
_cache_completion jj jj util completion zsh

# append completions to fpath
fpath=(${ASDF_DIR}/completions "$ZSH_COMPLETION_CACHE" $fpath)

# initialise completions with ZSH's compinit (exactly once, see below for the
# removed duplicate). The dump is fully rebuilt at most once every 24h; the
# rest of the time -C loads it without re-auditing every fpath directory.
#
# -C trusts the dump and does NOT rescan fpath, so a completion file written
# after the dump was built would never be picked up. Whenever the block above
# (re)generates one, drop the dump to force a full rescan.
_init_completions() {
  setopt local_options extended_glob
  local dump="${ZDOTDIR:-$HOME}/.zcompdump"
  (( _completion_cache_changed )) && rm -f "$dump"
  autoload -Uz compinit
  if [[ -n $dump(#qN.mh-24) ]]; then
    compinit -C -d "$dump"
  else
    compinit -d "$dump"
  fi
}
_init_completions
unfunction _init_completions
unset _completion_cache_changed
alias rm='trash-put'
eval "$(direnv hook zsh)"
# eval "$(zoxide init zsh --cmd cd)"
# gh completion is cached into $ZSH_COMPLETION_CACHE above, not eval'd here.

autoload -Uz add-zsh-hook

# for async update right prompt
mkdir -p ${TMPPREFIX}

RPROMPT_WORK_FNAME=zsh_prompt_hook.$$
RPROMPT_WORK=${TMPPREFIX}/${RPROMPT_WORK_FNAME}

function _prompt_is_in_git {
  if git rev-parse 2> /dev/null; then
    echo true
  else
    echo false
  fi
}

function _fetch_if_in_git {
  if [[ -d ".git" ]] ; then
    git fetch&
  fi
}

# add-zsh-hook chpwd _fetch_if_in_git

function _prompt_git_branch_name {
  echo $(git symbolic-ref --short HEAD 2> /dev/null || git rev-parse --short HEAD 2> /dev/null)
}

function _prompt_git_staged {
  if ! git diff --staged --no-ext-diff --ignore-submodules --quiet --exit-code 2> /dev/null ; then
    echo "●"
  else
    echo ""
  fi
}

function _prompt_git_unstaged {
  if ! git diff --no-ext-diff --ignore-submodules --quiet --exit-code 2> /dev/null ; then
    echo "●"
  else
    echo ""
  fi
}

function _prompt_git_untracked {
  if [[ -z $(git ls-files --other --exclude-standard 2> /dev/null) ]] ; then
    echo ""
  else
    echo "●"
  fi
}

function _prompt_git_not_pushed()
{

    if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ] \
       && [ "$(g remote | wc | awk '{print $1;}' 2>/dev/null)" -ne "0" ] ; then
    head="$(git rev-parse HEAD 2>/dev/null)"
    for x in $(git rev-parse --remotes)
    do
      if [ "$head" = "$x" ]; then
        return 0
      fi
    done
    echo "▲"
  fi
  return 0
}



function _git_stat_update {
  if [ $(_prompt_is_in_git) = "true" ] ; then
    if [ ! -d {TMPPREFIX} ]; then
      mkdir -p ${TMPPREFIX}
    fi

    echo $(pwd) > ${RPROMPT_WORK}
    echo -n "%F{${RPROMPT_FG_COLOR}}[" >> ${RPROMPT_WORK}
    echo -n "%F{${VC_BRANCH_FG}}$(_prompt_git_branch_name)" >> ${RPROMPT_WORK}
    echo -n "%F{${VC_STAGED_FG}}$(_prompt_git_staged)" >> ${RPROMPT_WORK}
    echo -n "%F{${VC_UNSTAGED_FG}}$(_prompt_git_unstaged)" >> ${RPROMPT_WORK}
    echo -n "%F{${VC_UNTRACKED_FG}}$(_prompt_git_untracked)" >> ${RPROMPT_WORK}
    echo -n "%F{${VC_UNPUSHED_FG}}$(_prompt_git_not_pushed)" >> ${RPROMPT_WORK}
    echo "%F{${RPROMPT_FG_COLOR}}:%(4~,%-1~/.../%2~,%~)]%f" >> ${RPROMPT_WORK}

    kill -s USR2 $$
  fi
}

function _async_git_stat_update {
  RPROMPT=$RPROMPT_BASE

  # fail safe to clean up dead file
  if [ -f ${RPROMPT_WORK} ] ; then
    find ${TMPPREFIX} -name ${RPROMPT_WORK_FNAME} -mmin +5 -type f -exec rm -f {} \;
  fi

  if [ ! -f ${RPROMPT_WORK} ] ; then
    _git_stat_update &!
  fi
}

function TRAPUSR2 {
  if [ -f ${RPROMPT_WORK} ] ; then
    lines=( ${(@f)"$(< ${RPROMPT_WORK})"} )
    if [[ "$lines[1]" = "$(pwd)" ]] ; then
      RPROMPT=$lines[2]
    fi
    rm -f ${RPROMPT_WORK}

    # Force zsh to redisplay the prompt.
    zle && zle reset-prompt
  fi
}

add-zsh-hook precmd _async_git_stat_update


# prompt
PROMPT_FG_COLOR=white
RPROMPT_FG_COLOR=white

# git status
# untracked yellow ●
# modify    red ●
# staged   green ●
# unpush   red ▲
VC_BRANCH_FG=136
VC_STAGED_FG=green
VC_UNSTAGED_FG=red
VC_UNTRACKED_FG=136
VC_UNPUSHED_FG=red

case ${UID} in
0)
  PROMPT_FG_COLOR=red
  ;;
*)
  PROMPT_FG_COLOR=black
  ;;
esac

PROMPT_CL_PREFIX="%F{${PROMPT_FG_COLOR}}"
PROMPT_PREFIX="${PROMPT_CL_PREFIX}"

PROMPT_CL_SUFIX="%f"
RPROMPT_CL_SUFIX="%f"

[ -n "${REMOTEHOST}${SSH_CONNECTION}" ] &&
    PROMPT_PREFIX="${PROMPT_PREFIX}%n@%m"

# PROMPT="${PROMPT_PREFIX}%#${PROMPT_CL_SUFIX} "
# PROMPT2="${PROMPT_CL_PREFIX}%_\$${PROMPT_CL_SUFIX} "
# SPROMPT="${PROMPT_CL_PREFIX}%r is correct? [n,y,a,e]:${PROMPT_CL_SUFIX} "
PROMPT="%F{white}%D %* %%%f "
RPROMPT_BASE="%F{${RPROMPT_FG_COLOR}}[%(4~,%-1~/.../%2~,%~)]%f"
RPROMPT="${RPROMPT_BASE}"
# (second compinit removed - it is initialised once near the top of this file)

setopt correct
setopt auto_cd
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
source ~/.hotspot_config.zsh
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
# zinit. The installer chunk in ~/.zshrc normally sources zinit before this
# file is read, so only bootstrap when it has not been loaded yet - sourcing
# zinit.zsh a second time re-runs its whole setup for nothing.
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if (( ! ${+functions[zinit]} )); then
  [ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
  [ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
  source "${ZINIT_HOME}/zinit.zsh"
fi
zinit load zsh-users/zsh-syntax-highlighting
zinit load zsh-users/zsh-autosuggestions
zinit load zsh-users/zsh-completions
zinit load mollifier/cd-gitroot
# jj completion is cached into $ZSH_COMPLETION_CACHE above, not sourced here.
